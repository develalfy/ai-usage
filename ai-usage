#!/usr/bin/env bash
# ai-usage — one-line usage bar for AI subscriptions.
# Reads provider creds from env or ~/.config/ai-usage/{provider} file.
# Usage: ai-usage [--bar] [--watch N]   # --bar for tmux, --watch N for refresh
# Lazy: probes only what's reachable; skips providers with no key/endpoint.
# ponytail: hardcoded endpoint list — extend when adding a provider.

set -u
DIR="${AI_USAGE_CONFIG:-$HOME/.config/ai-usage}"
mkdir -p "$DIR"

# ponytail: single python3 call parses JSON, replaces jq dep. python3 -c is stdlib.
py() { python3 -c "import sys,json; d=json.load(sys.stdin);
import functools,operator
v=$1
try:
    cur,total=v; print(f'{cur}/{total}')
except Exception:
    print(v) if v is not None else print('?')" 2>/dev/null; }

# Provider probe — each prints "<short_name>:<display>" or "<short_name>:err"
providers=(
  "openrouter|OpenRouter|https://openrouter.ai/api/v1/auth/key|Authorization|"
  "anthropic|Claude|https://api.anthropic.com/v1/organizations/me|x-api-key|anthropic-version:2023-06-01|monthly_spend"
  "openai|OpenAI|https://api.openai.com/v1/dashboard/billing/credit_grants|Authorization|"
  "copilot|GitHub|https://api.github.com/copilot_internal/user|Authorization|"
)

bar=""
for entry in "${providers[@]}"; do
  IFS='|' read -r short name url hdr_style hdr_val field <<<"$entry"
  key=""
  [ -f "$DIR/$short" ] && key=$(<"$DIR/$short")
  [ -z "$key" ] && continue
  case "$hdr_style" in
    x-api-key)       auth_hdr=(-H "x-api-key: $key") ;;
    Authorization)   auth_hdr=(-H "Authorization: Bearer $key") ;;
    *)               continue ;;
  esac
  resp=$(curl -s --max-time 4 "${auth_hdr[@]}" ${hdr_val:+-H "$hdr_val"} "$url" 2>/dev/null) || continue
  # ponytail: try common shapes; first parse wins. Add shape when a new provider lands.
  out=$(printf '%s' "$resp" | python3 -c "
import sys,json
d=json.load(sys.stdin)
for path in [
    ['data',0,'usage'],          # openrouter
    ['monthly_spend'],           # anthropic org
    ['total_granted'],           # openai credit_grants (cents)
    ['copilot_plan']             # copilot
]:
    try:
        v=d
        for k in path: v=v[k]
        if isinstance(v,(int,float)): print(f'{v:.2f}')
        else: print(v)
        sys.exit(0)
    except (KeyError,TypeError,IndexError): pass
print('?')
" 2>/dev/null)
  [ -z "$out" ] && out="?"
  bar+="${short}:${out} "
done

# Fallback if nothing responded (no keys configured yet)
[ -z "$bar" ] && bar="(no keys — drop one in ~/.config/ai-usage/openrouter|anthropic|openai|copilot) "

if [ "${1:-}" = "--bar" ]; then
  printf '%s' "$bar"
else
  printf '\033[1;36mai-use\033[0m  %s\n' "$bar"
fi