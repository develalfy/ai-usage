#!/usr/bin/env bash
# ai-usage — one-line usage bar for AI subscriptions.
# Reads provider creds from a file in $AI_USAGE_CONFIG (default ~/.config/ai-usage).
# Usage: ai-usage [--bar]
# ponytail: hardcoded endpoint list — extend when adding a provider.

set -u
DIR="${AI_USAGE_CONFIG:-$HOME/.config/ai-usage}"
mkdir -p "$DIR"

# Provider probe — each prints "<short>:<value>"; missing key skips silently.
# ponytail: paths are best-guess; field comment names the value to extract.
providers=(
  "openrouter|OpenRouter|https://openrouter.ai/api/v1/auth/key|Authorization||data,0,usage"
  "anthropic|Claude|https://api.anthropic.com/v1/organizations/me|x-api-key|anthropic-version:2023-06-01|id"
  "openai|OpenAI|https://api.openai.com/v1/dashboard/billing/credit_grants|Authorization||total_granted"
  "copilot|GitHub|https://api.github.com/copilot_internal/user|Authorization||copilot_plan"
)

bar=""
for entry in "${providers[@]}"; do
  IFS='|' read -r short name url hdr_style hdr_val field <<<"$entry"
  key_file="$DIR/$short"
  [ -f "$key_file" ] || continue
  # ponytail: warn on lax key perms — silent is fine, loud on bad. owner must be 6/7.
  perms=$(stat -c %a "$key_file" 2>/dev/null)
  case "$perms" in
    [67][06][06]) ;;
    *) printf 'ai-use  WARN: %s is mode %s (want 600)\n' "$key_file" "${perms:-?}" >&2 ;;
  esac
  key=$(<"$key_file")
  case "$hdr_style" in
    x-api-key)     auth_hdr=(-H "x-api-key: $key") ;;
    Authorization) auth_hdr=(-H "Authorization: Bearer $key") ;;
    *)             continue ;;
  esac
  resp=$(curl -s --max-time 4 "${auth_hdr[@]}" ${hdr_val:+-H "$hdr_val"} "$url" 2>/dev/null) || continue
  out=$(printf '%s' "$resp" | python3 -c "
import sys,json
d=json.load(sys.stdin)
path='$field'.split(',')
try:
    v=d
    for k in path:
        v=v[int(k)] if k.isdigit() else v[k]
    if isinstance(v,(int,float)): print(f'{v:.2f}')
    else: print(v)
except Exception: print('?')
" 2>/dev/null)
  [ -n "$out" ] || out="?"
  bar+="${short}:${out} "
done

[ -z "$bar" ] && bar="(no keys — drop one in ~/.config/ai-usage/{openrouter,anthropic,openai,copilot}, mode 600) "

if [ "${1:-}" = "--bar" ]; then
  printf '%s' "$bar"
else
  printf '\033[1;36mai-use\033[0m  %s\n' "$bar"
fi